{
  "manifest_version": 3,
  "name": "技术瓜群流",
  "version": "0.9.29",
  "author": "0xTechMelon",
  "homepage_url": "https://docs.jishugua.top",
  "description": "技术瓜出品。把本机微信群消息做成信息流，可插入 gmgn 推特监控页，也可在白名单网页上使用可拖拽浮窗。",
  "permissions": ["storage", "offscreen", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*", "https://gmgn.ai/*", "*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "技术瓜群流 · 𝕏 @0xTechMelon"
  },
  "content_scripts": [
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["feed.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gmgn.ai/*"],
      "js": ["gmgn_main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
